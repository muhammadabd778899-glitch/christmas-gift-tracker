# Copy to .env.online.local for local development and online builds.
# The anon key is a public client key; RLS enforces ownership. Never place a
# service-role key, database password, or other secret in this file.
VITE_EDITION=online
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
